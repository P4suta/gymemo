    "oneRepMaxNote" : { "extractionState" : "manual", "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "The estimated 1RM is a rough guide to the weight you could lift once, computed from a set's weight and reps. The chart shows the highest value of each day." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "推定1RMは、1回だけ挙げられる重量を、重量と回数から見積もった目安です。日ごとの最高値を表示します。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "预估 1RM 是根据重量和次数估算出的单次最大重量，仅供参考。图表显示每天的最高值。" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "預估 1RM 是根據重量和次數估算出的單次最大重量，僅供參考。圖表顯示每天的最高值。" } } } },
    "repsNote" : { "extractionState" : "manual", "localizations" : {
