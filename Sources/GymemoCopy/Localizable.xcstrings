      "en" : { "stringUnit" : { "state" : "translated", "value" : "Saves every exercise, set, and note on this device to one JSON file. Export a backup before changing devices." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "端末内のすべての種目、セット、メモを1つのJSONファイルに保存します。機種を変える前に書き出してください。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将设备上的所有动作、训练记录和备注保存为一个JSON文件。更换设备前请先导出备份。" } },
