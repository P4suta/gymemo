    "watchSaved" : { "extractionState" : "manual", "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Saved on iPhone" } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneに保存済み" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已存储到iPhone" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已儲存至iPhone" } } } },
    "watchRefused" : { "extractionState" : "manual", "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't Save on iPhone" } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneに保存できませんでした" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未能存储到iPhone" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法儲存至iPhone" } } } },
    "watchExerciseMissing" : { "extractionState" : "manual", "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "The exercise no longer exists on iPhone. Keep the Watch record and enter the set on iPhone under an existing exercise." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneに種目がありません。Watchの記録を残し、iPhoneの登録済みの種目にセットを入力してください。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iPhone上已无该训练项目。请保留Watch记录，并在iPhone的现有训练项目中输入该组。" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "iPhone上已無該訓練項目。請保留Watch紀錄，並在iPhone的現有訓練項目中輸入該組。" } } } },
    "watchIdentifierConflict" : { "extractionState" : "manual", "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "iPhone already has a different set with the same identifier. Compare the records on both devices." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneには同じ識別子で異なるセットが保存されています。両方の端末の記録を比較してください。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iPhone上已有标识符相同但内容不同的训练组。请比较两个设备上的记录。" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "iPhone上已有識別碼相同但內容不同的訓練組。請比較兩部裝置上的紀錄。" } } } },
    "watchPhoneFull" : { "extractionState" : "manual", "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "The iPhone log is full. Export a backup, remove unneeded sets on iPhone, and try again." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneの記録件数が上限に達しました。バックアップを書き出し、iPhoneで不要なセットを削除して再試行してください。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iPhone的记录已满。请导出备份，在iPhone上删除不需要的训练组后重试。" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "iPhone的紀錄已滿。請匯出備份，在iPhone上刪除不需要的訓練組後再試。" } } } },
    "watchNeedsPhone" : { "extractionState" : "manual", "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Open gymemo on iPhone" } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneでgymemoを開いてください" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在iPhone上打开gymemo" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在iPhone上開啟gymemo" } } } },
    "watchHelp" : { "extractionState" : "manual", "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Your paired iPhone sends up to 40 exercises, with recent exercises first. Open gymemo on iPhone after changing exercises. Once the exercises arrive, you can log sets while your iPhone is away. Other devices keep separate logs." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "ペアリングしたiPhoneから、最近の種目を優先して最大40種目を受け取ります。種目の変更後はiPhoneでgymemoを開いてください。種目を受け取った後は、iPhoneが近くになくてもセットを記録できます。ほかの端末の記録とは同期しません。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配对的iPhone会发送最多40个训练项目，最近使用的项目排在前面。更改训练项目后，请在iPhone上打开gymemo。收到训练项目后，即使iPhone不在身边，也能记录训练组。其他设备的记录不会同步。" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "配對的iPhone會傳送最多40個訓練項目，最近使用的項目排在前面。更改訓練項目後，請在iPhone上開啟gymemo。收到訓練項目後，即使iPhone不在身邊，也能記錄訓練組。其他裝置的紀錄不會同步。" } } } },
    "watchWaitingHint" : { "extractionState" : "manual", "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Sets stay on Apple Watch until your iPhone confirms storage. Transfer runs when the system permits. Keep both apps installed until every pending set is saved on iPhone." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "iPhoneの保存完了を確認するまで、セットをApple Watch内に保持します。転送のタイミングはシステムが決めます。送信待ちのセットがiPhoneに保存されるまで、両方のアプリを削除しないでください。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iPhone确认存储前，训练组会保留在Apple Watch上。系统决定传输时间。所有待传输的训练组存储到iPhone前，请保留两个设备上的应用。" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "iPhone確認儲存前，訓練組會保留在Apple Watch上。系統會決定傳輸時間。所有待傳輸的訓練組儲存至iPhone前，請保留兩部裝置上的App。" } } } },
    "watchTransferFailed" : { "extractionState" : "manual", "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Transfer couldn't finish. Your saved records remain on the device. Open gymemo on both devices and try again." } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "転送できませんでした。保存した記録は端末内に残っています。両方の端末でgymemoを開き、再試行してください。" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "传输未完成。已存储的记录仍保留在设备上。请在两个设备上打开gymemo后重试。" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "傳輸未完成。已儲存的紀錄仍保留在裝置上。請在兩部裝置上開啟gymemo後再試。" } } } },
    "retry" : { "extractionState" : "manual", "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Try Again" } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "再試行" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重试" } },
      "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "再試一次" } } } },
    "privacyPolicy" : { "extractionState" : "manual", "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Privacy Policy" } },
      "ja" : { "stringUnit" : { "state" : "translated", "value" : "プライバシーポリシー" } },
      "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐私政策" } },
